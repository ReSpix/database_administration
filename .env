# .env
# API configuration - CHANGE API_HOST to your backend service name or IP
# For Docker: use service name (e.g., "backend") or "host.docker.internal" for host machine
# For local dev: "localhost"
API_SCHEME=http
API_HOST=backend
API_PORT=8000
API_TIMEOUT=5.0
API_HEALTH_PATH=/health            # endpoint that returns 200 when backend is alive
API_MAX_RETRIES=3
API_RETRY_BACKOFF=0.5              # seconds; exponential ×2 each retry

# Simulation parameters (normal mode)
SIM_SEED=42
SIM_DURATION=3600
SIM_ORDER_RATE=0.2
SIM_COURIER_TICK=2.0
SIM_PREFLIGHT=true                 # do health-check before start

# Quick test mode (10 sec, slow for observation)
SIM_QUICK=false                    # set to "true" for 10-second quick test
SIM_QUICK_DURATION=10.0
SIM_QUICK_ORDER_RATE=0.5           # 1 order per 2 seconds
SIM_QUICK_COURIER_TICK=1.0         # courier tick every 1 second

# Scenario selection (optional)
# SIM_SCENARIO=quick_demo          # or: single_courier_two_restaurants, stress_test, slow_observation
# SIM_LIST_SCENARIOS=true          # list available scenarios and exit