# .env
API_SCHEME=http
API_HOST=dispatch-service          # или IP, если запускаете вручную
API_PORT=8080
API_TIMEOUT=5.0
API_HEALTH_PATH=/health            # эндпоинт, который отвечает 200, когда бэкенд жив
API_MAX_RETRIES=3
API_RETRY_BACKOFF=0.5              # секунды; экспоненциально ×2 каждый раз

SIM_SEED=42
SIM_DURATION=3600
SIM_ORDER_RATE=0.2
SIM_COURIER_TICK=2.0
SIM_PREFLIGHT=true                 # сделать health-check перед стартом