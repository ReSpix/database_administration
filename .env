# .env
# API configuration - CHANGE API_HOST to your backend service name or IP
# For Docker: use service name (e.g., "dispatch-service", "backend") or "host.docker.internal" for host machine
# For local dev: "localhost"
API_SCHEME=http
API_HOST=dispatch-service
API_PORT=8080
API_TIMEOUT=5.0
API_HEALTH_PATH=/health            # endpoint that returns 200 when backend is alive
API_MAX_RETRIES=3
API_RETRY_BACKOFF=0.5              # seconds; exponential ×2 each retry

# Simulation parameters
SIM_SEED=42
SIM_DURATION=3600
SIM_ORDER_RATE=0.2
SIM_COURIER_TICK=2.0
SIM_PREFLIGHT=true                 # do health-check before start